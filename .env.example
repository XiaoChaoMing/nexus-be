# NexusLive local development. `make` reads .env (or this file); docker compose sets its own values.
NXL_ENV=dev
# Nginx edge (make nxl-up-all): http://localhost:8080
NXL_EDGE_PORT=8080
# CORS: the only browser origins allowed to call the edge with credentials (/v1/admin/* only the admin app).
# Exact scheme://host[:port], no trailing slash; the two must differ.
NXL_WEB_ORIGIN=http://localhost:5173
NXL_ADMIN_ORIGIN=http://localhost:5174
# Edge rate limits per client IP (nginx limit_req rate, r/s or r/m); excess -> 429 RATE_LIMITED.
# Auth: login, register, password forgot/reset, e-mail verification (burst 5).
NXL_EDGE_AUTH_RATE=10r/m
NXL_EDGE_WRITE_RATE=60r/m
NXL_EDGE_READ_RATE=600r/m
# NexusLive service databases (PostgreSQL 18)
NXL_PG_URL_IDENTITY=postgres://user:myAwEsOm3pa55%40w0rd@localhost:5432/nxl_identity
NXL_PG_URL_CHANNEL=postgres://user:myAwEsOm3pa55%40w0rd@localhost:5432/nxl_channel
NXL_PG_URL_STREAM=postgres://user:myAwEsOm3pa55%40w0rd@localhost:5432/nxl_stream
NXL_PG_URL_CHAT=postgres://user:myAwEsOm3pa55%40w0rd@localhost:5432/nxl_chat
NXL_PG_URL_SAFETY=postgres://user:myAwEsOm3pa55%40w0rd@localhost:5432/nxl_safety
NXL_PG_URL_NOTIFICATION=postgres://user:myAwEsOm3pa55%40w0rd@localhost:5432/nxl_notification
NXL_PG_URL_BILLING=postgres://user:myAwEsOm3pa55%40w0rd@localhost:5432/nxl_billing
NATS_URL=nats://guest:guest@localhost:4222/
# Shared secret for internal calls (media-svc -> stream-svc); required outside dev
NXL_INTERNAL_SECRET=dev-internal-secret
# Swagger UI at /swagger/index.html of identity-svc (:8090), channel-svc (:8094) and stream-svc (:8092), not through the edge
NXL_SWAGGER_ENABLED=true
# identity-svc
IDENTITY_HTTP_PORT=8090
# Base64 of a 32-byte Ed25519 seed (openssl rand -base64 32). Empty in dev = random key per start.
IDENTITY_JWT_PRIVATE_KEY=
IDENTITY_ACCESS_TTL=15m
IDENTITY_REFRESH_TTL=720h
IDENTITY_COOKIE_SECURE=false
# Verification / password-reset e-mails (Mailpit in dev, UI http://localhost:8025). Empty = only logged.
IDENTITY_SMTP_ADDR=localhost:1025
IDENTITY_MAIL_FROM=no-reply@nexuslive.dev
# Base URL of the web app used in e-mail links (/verify-email, /reset-password)
IDENTITY_WEB_BASE_URL=http://localhost:5173
IDENTITY_EMAIL_VERIFY_TTL=24h
IDENTITY_PASSWORD_RESET_TTL=30m
# Temporary lock after this many wrong passwords in a row
IDENTITY_LOGIN_MAX_FAILURES=10
IDENTITY_LOGIN_LOCK_DURATION=15m
# Creator applications: e-mail must be verified, minimum age
IDENTITY_REQUIRE_VERIFIED_FOR_CREATOR=true
IDENTITY_CREATOR_MIN_AGE=18
# Dev only (NXL_ENV=dev): seeds admin@nexuslive.dev (ADMIN) and creator@nexuslive.dev (approved creator)
IDENTITY_DEV_SEED=true
IDENTITY_DEV_SEED_PASSWORD=nexuslive123
# channel-svc
CHANNEL_HTTP_PORT=8094
CHANNEL_LOG_LEVEL=debug
CHANNEL_PG_POOL_MAX=4
CHANNEL_JWKS_URL=http://localhost:8090/v1/auth/.well-known/jwks.json
# Empty = viewerCount is always null (counts are written by chat-svc)
CHANNEL_REDIS_ADDR=localhost:6379
# Public bucket of avatars, banners and category covers (served by the edge under /media/)
CHANNEL_S3_ENDPOINT=localhost:9000
CHANNEL_S3_ACCESS_KEY=minioadmin
CHANNEL_S3_SECRET_KEY=minioadmin123
CHANNEL_S3_USE_SSL=false
CHANNEL_PUBLIC_BUCKET=nxl-public
CHANNEL_S3_ENSURE_BUCKET=true
CHANNEL_MEDIA_BASE=/media
CHANNEL_AVATAR_MAX_BYTES=2097152
CHANNEL_BANNER_MAX_BYTES=5242880
CHANNEL_HANDLE_CHANGE_INTERVAL=720h
CHANNEL_SEARCH_VIEWER_TICK=30s
CHANNEL_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# Schedule jobs (occurrence_upcoming, reminder_due); 0 turns them off
CHANNEL_SCHEDULE_TICK=1m
CHANNEL_SCHEDULE_UPCOMING_LEAD=24h
CHANNEL_SCHEDULE_MAX_ACTIVE=20
CHANNEL_SCHEDULE_HORIZON=2160h
CHANNEL_SCHEDULE_WINDOW=336h
CHANNEL_REMINDER_LEAD=10m
# stream-svc
STREAM_INGEST_GRACE_PERIOD=60s
# Refuse publishes this long after the creator ends a stream (OBS auto-reconnect); 0 disables
STREAM_END_COOLDOWN=30s
STREAM_VOD_EXPIRY_TICK=10m
# Read-only viewer counts written by chat-svc (key viewers:{streamId}); empty = viewerCount is always null
STREAM_REDIS_ADDR=localhost:6379
# Go Live attaches to a SCHEDULED stream from 30 min before to 60 min after its start; later it is CANCELLED
STREAM_SCHEDULE_EARLY_START=30m
STREAM_SCHEDULE_LATE_GRACE=60m
STREAM_SCHEDULE_TICK=1m
# media-svc (MEDIA_STATIC_STREAM_KEY only for standalone mode without stream-svc)
MEDIA_MAX_CONCURRENT_STREAMS=2
MEDIA_GRACE_PERIOD=90s
MEDIA_X264_PRESET=veryfast
# chat-svc (two instances in compose: chat-1 :8095, chat-2 :8096). WebSocket /v1/ws and REST on one port.
CHAT_HTTP_PORT=8095
CHAT_LOG_LEVEL=debug
CHAT_PG_POOL_MAX=8
CHAT_NATS_URL=nats://guest:guest@localhost:4222/
CHAT_REDIS_ADDR=localhost:6379
CHAT_JWKS_URL=http://localhost:8090/v1/auth/.well-known/jwks.json
# Browser origins allowed to open /v1/ws (comma-separated); clients without Origin (scripts, k6) are allowed
CHAT_ALLOWED_ORIGINS=http://localhost:5173
# Realtime gateway (NXL-00 §10): auth deadline, heartbeat, idle close, limits, resume buffer, send queue
CHAT_WS_AUTH_TIMEOUT=5s
CHAT_WS_HEARTBEAT=25s
CHAT_WS_IDLE_TIMEOUT=60s
CHAT_WS_MAX_SUBSCRIPTIONS=20
CHAT_WS_MAX_CONN_PER_USER=5
CHAT_WS_RESUME_BUFFER=200
CHAT_WS_RESUME_TTL=5m
CHAT_WS_SEND_QUEUE=256
# Messages per user per window; a higher ceiling for streamer/moderators/admins; per client IP
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=30s
CHAT_RATE_LIMIT_PRIVILEGED=100
CHAT_RATE_LIMIT_IP=60
CHAT_DUPLICATE_WINDOW=30s
CHAT_MAX_LINES=3
CHAT_HISTORY_ON_JOIN=50
# Sampling: above THRESHOLD messages/s in a room, each client gets at most CAP/s (priority messages always)
CHAT_SAMPLING_THRESHOLD=30
CHAT_SAMPLING_CAP=15
CHAT_RETENTION=720h
CHAT_PARTITION_TICK=1h
CHAT_VIEWER_INTERVAL=10s
# viewer_count_batch on sidebar:{userId} (RT_BATCH_MS); 0 turns it off
CHAT_SIDEBAR_BATCH_INTERVAL=5s
# Kill switch: every room read only (CHAT_DISABLED)
CHAT_DISABLED=false
CHAT_REQUIRE_VERIFIED_EMAIL=false
