{
    "swagger": "2.0",
    "info": {
        "description": "Stream keys, Studio, live catalog and VODs. Get a token from identity-svc (http://localhost:8090/swagger/index.html → /auth/login) and paste \"Bearer \u003caccessToken\u003e\" into Authorize.",
        "title": "NexusLive stream-svc API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/v1",
    "paths": {
        "/me/continue-watching": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Positions below 5 s and VODs watched to within 10 s of the end are left out, like expired VODs.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "playback"
                ],
                "summary": "VODs the signed-in viewer has not finished, newest first",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 12,
                        "description": "1–50",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Data-internal_controller_restapi_v1_ContinueList"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/me/watch-progress/{vodId}": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Clients send it at most every 15 s and when leaving. keepFurther=true keeps a further stored position (used to merge a browser's local progress after sign-in).",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "playback"
                ],
                "summary": "Save the VOD position of the signed-in viewer",
                "parameters": [
                    {
                        "type": "string",
                        "description": "vod id (uuid)",
                        "name": "vodId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "position",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ProgressRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "VALIDATION_FAILED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/streams": {
            "get": {
                "description": "channel is null for streams whose channel is unknown to stream-svc.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "streams"
                ],
                "summary": "Streams on air (LIVE and INTERRUPTED), newest first",
                "parameters": [
                    {
                        "enum": [
                            "live"
                        ],
                        "type": "string",
                        "default": "live",
                        "description": "only live",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "nextCursor of the previous page",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 24,
                        "description": "page size (1–50)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Data-internal_controller_restapi_v1_StreamList"
                        }
                    },
                    "400": {
                        "description": "VALIDATION_FAILED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/streams/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "streams"
                ],
                "summary": "Stream detail (status, manifestUrl, vodId once the VOD is ready)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "stream id (uuid)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Data-Stream"
                        }
                    },
                    "404": {
                        "description": "NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/streams/{id}/playback": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Guests may call it; send X-NXL-Anon-Id when you have one. Mature streams return mature.required=true and no manifestUrl until called again with acknowledgeMature=true (signed-in viewers are remembered per channel). manifestUrl gains a signature in GĐ5.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "playback"
                ],
                "summary": "Open a live (or ended) stream for playback",
                "parameters": [
                    {
                        "type": "string",
                        "description": "stream id (uuid)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "guest browser id (uuid)",
                        "name": "X-NXL-Anon-Id",
                        "in": "header"
                    },
                    {
                        "description": "age confirmation",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/PlaybackRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Data-internal_controller_restapi_v1_Playback"
                        }
                    },
                    "400": {
                        "description": "VALIDATION_FAILED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED (token sent but invalid)",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/studio/stream": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "current is null when the channel is offline; health is the latest ingest report (5 s).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "studio"
                ],
                "summary": "Studio: the creator's channel, settings and the current broadcast",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Data-internal_controller_restapi_v1_Studio"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "NOT_CREATOR",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Applies to the next broadcast and to the one on air, if any. Title 1–140, at most 10 tags of ≤ 25 characters.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "studio"
                ],
                "summary": "Update title / tags / mature flag",
                "parameters": [
                    {
                        "description": "Settings",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/SettingsRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Data-Settings"
                        }
                    },
                    "400": {
                        "description": "VALIDATION_FAILED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "NOT_CREATOR",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/studio/stream-key": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "studio"
                ],
                "summary": "Stream key status (never the key itself)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Data-internal_controller_restapi_v1_StreamKeyInfo"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "NOT_CREATOR",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "The key is returned only here, once. The previous key stops working immediately.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "studio"
                ],
                "summary": "Create / regenerate the stream key",
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/Data-internal_controller_restapi_v1_StreamKeyCreated"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "NOT_CREATOR",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/studio/stream/end": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Moves the stream to ENDED; media-svc disconnects OBS and publishes the VOD.",
                "tags": [
                    "studio"
                ],
                "summary": "End the broadcast",
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "NOT_CREATOR",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "NOT_LIVE",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/vods/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "With a token, viewer.positionSec is the caller's saved position (null when never watched).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vods"
                ],
                "summary": "VOD (READY and not expired)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "vod id (uuid)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Data-internal_controller_restapi_v1_VOD"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED (token sent but invalid)",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/vods/{id}/playback": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Same rules as /streams/{id}/playback; a VOD inherits the mature flag of its broadcast.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "playback"
                ],
                "summary": "Open a VOD for playback",
                "parameters": [
                    {
                        "type": "string",
                        "description": "vod id (uuid)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "guest browser id (uuid)",
                        "name": "X-NXL-Anon-Id",
                        "in": "header"
                    },
                    {
                        "description": "age confirmation",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/PlaybackRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Data-internal_controller_restapi_v1_Playback"
                        }
                    },
                    "400": {
                        "description": "VALIDATION_FAILED",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED (token sent but invalid)",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        }
    },
